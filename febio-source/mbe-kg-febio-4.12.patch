+// Computes the full asymmetric dyadic (outer) product of two vectors: a (x) b 	// MOD-ABC
+inline mat3d dyad1(const vec3d& a, const vec3d& b)
+{
+	return mat3d(
+		a.x * b.x, a.x * b.y, a.x * b.z,
+		a.y * b.x, a.y * b.y, a.y * b.z,
+		a.z * b.x, a.z * b.y, a.z * b.z
+	);
+}
+// Computes the symmetric dyadic product of two vectors: 1/2 * (a (x) b + b (x) a) 	// MOD-ABC
+inline mat3ds dyad1s(const vec3d& a, const vec3d& b)
+{
+	return mat3ds(
+		a.x * b.x,
+		a.y * b.y,
+		a.z * b.z,
+		0.5 * (a.x * b.y + a.y * b.x),
+		0.5 * (a.y * b.z + a.z * b.y),
+		0.5 * (a.x * b.z + a.z * b.x)
+	);
+}
