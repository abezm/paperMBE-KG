+{
+	double val = 0.0;
+	int nint = el.GaussPoints();
+	for (int i=0; i<nint; ++i)
+	{
+		FEMaterialPoint& pt = *el.GetMaterialPoint(i);
+        	FEKinematicMaterialPointZ* pg = pt.ExtractData<FEKinematicMaterialPointZ>();
+		
+		val += (float) pg->m_Fg(0,0);
+		//val += pg.m_Fg(0,0);
+	}
+	return val / (double) nint;
