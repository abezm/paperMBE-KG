+// 2. Implementación nativa usando writeAverageElementValue
+bool FEPlotElastinDamage::Save(FEDomain& dom, FEDataStream& a)
+{
+	FEKinematicGrowthZ* pme = dom.GetMaterial()->ExtractProperty<FEKinematicGrowthZ>();
+	if (pme == nullptr) return false;
+
+	writeAverageElementValue<double>(dom, a, FEElastinDamageVal());
+	return true;
+}
+
+bool FEPlotCollagenDamage::Save(FEDomain& dom, FEDataStream& a)
+{
+	FEKinematicGrowthZ* pme = dom.GetMaterial()->ExtractProperty<FEKinematicGrowthZ>();
+	if (pme == nullptr) return false;
+
+	writeAverageElementValue<double>(dom, a, FECollagenDamageVal());
+	return true;
+}
+
+class FECurrentStrainEnergyVal {
+    FEElasticMaterial* m_mat; 
+public:
+    FECurrentStrainEnergyVal(FEElasticMaterial* mat) : m_mat(mat) {}
+
+    double operator()(const FEMaterialPoint& mp) {
+        if (m_mat) {
+            FEMaterialPoint& mp_nc = const_cast<FEMaterialPoint&>(mp);
+            FEElasticMaterialPoint* ep = mp_nc.ExtractData<FEElasticMaterialPoint>();
+            FEKinematicMaterialPointZ* pt = mp_nc.ExtractData<FEKinematicMaterialPointZ>();
+            
+            if (ep && pt) {
+                double W_ref = m_mat->StrainEnergyDensity(mp_nc);
+                double W_cur = W_ref / ep->m_J;
+                
+                pt->m_Wt = W_cur;
+                
+                return W_cur;
+            }
+        }
+        return 0.0;
+    }
+};
+
+bool FEPlotCurrentStrainEnergyZ::Save(FEDomain& dom, FEDataStream& a)
+{
+    FEElasticMaterial* pmat = dom.GetMaterial()->ExtractProperty<FEElasticMaterial>();
+    if (pmat == nullptr) return false;
+
+    writeAverageElementValue<double>(dom, a, FECurrentStrainEnergyVal(pmat));
+    return true;
+}
