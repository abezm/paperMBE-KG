+	// TANCHECK: finite-difference check of TangentMm
+	int     m_fd_check;	// 1: run the check
+	double  m_fd_time;	// time at which the check runs
+	int     m_fd_elem;	// element ID (1-based)
+	int     m_fd_gp;	// integration point index (0-based), -1: all
+	double  m_fd_eps;	// relative perturbation of C
+	bool    m_dbg_infd;	// true while the check calls Stress()
