+//-----------------------------------------------------------------------------
+// TANCHECK (optional, debug only)
+// Central finite differences of the element internal force vector with respect to the
+// current nodal coordinates, compared with the element stiffness (geometric + material)
+// assembled by StiffnessMatrix(). K_fd(:,b) = -(fe(x + h e_b) - fe(x - h e_b))/(2h),
+// since ElementInternalForce returns fe = -f_int. History variables are not changed:
+// Stress() reads only the converged history (Jp, Fo, svo); the state of the element is
+// recomputed at the unperturbed coordinates at the end.
+void FEElasticSolidDomain::ElementFDCheck(int iel, matrix& ke, double eps)
+{
+	FESolidElement& el = m_Elem[iel];
+	const FETimeInfo& tp = GetFEModel()->GetTime();
+	int neln = el.Nodes();
+	int ndof = 3*neln;
+	FEMesh& mesh = *m_pMesh;
+
+	// element size
+	double hmax = 0.0;
+	for (int i = 0; i < neln; ++i) for (int j = 0; j < neln; ++j)
+		hmax = std::max(hmax, (mesh.Node(el.m_node[i]).m_rt - mesh.Node(el.m_node[j]).m_rt).norm());
+	double h = eps*hmax;
+
+	matrix Kfd(ndof, ndof); Kfd.zero();
+	vector<double> fp(ndof), fm(ndof);
+	for (int a = 0; a < neln; ++a)
+		for (int c = 0; c < 3; ++c)
+		{
+			FENode& node = mesh.Node(el.m_node[a]);
+			vec3d r0 = node.m_rt;
+			for (int sg = 0; sg < 2; ++sg)
+			{
+				vec3d r = r0;
+				double d = (sg == 0 ? h : -h);
+				if (c == 0) r.x += d; else if (c == 1) r.y += d; else r.z += d;
+				node.m_rt = r;
+				UpdateElementStress(iel, tp);
+				vector<double>& f = (sg == 0 ? fp : fm);
+				for (int k = 0; k < ndof; ++k) f[k] = 0.0;
+				ElementInternalForce(el, f);
+			}
+			node.m_rt = r0;
+			for (int k = 0; k < ndof; ++k) Kfd[k][3*a + c] = -(fp[k] - fm[k])/(2.0*h);
+		}
+	// restore the state at the unperturbed coordinates
+	UpdateElementStress(iel, tp);
+
+	double kmax = 0.0, emax = 0.0, asym = 0.0; int ei = 0, ej = 0;
+	for (int i = 0; i < ndof; ++i) for (int j = 0; j < ndof; ++j)
+	{
+		kmax = std::max(kmax, fabs(Kfd[i][j]));
+		double e = fabs(ke[i][j] - Kfd[i][j]);
+		if (e > emax) { emax = e; ei = i; ej = j; }
+		asym = std::max(asym, fabs(Kfd[i][j] - Kfd[j][i]));
+	}
+	feLog("EFDCHK t=%.10g elem=%d nodes=%d h=%.3e max|K_fd|=%.6e max|ke-K_fd|=%.6e at (%d,%d) ke=%.10e K_fd=%.10e rel=%.3e asym(K_fd)=%.3e\n",
+		tp.currentTime, el.GetID(), neln, h, kmax, emax, ei, ej, ke[ei][ej], Kfd[ei][ej], (kmax > 0 ? emax/kmax : 0.0), asym);
+}
