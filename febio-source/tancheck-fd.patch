+	int     m_dbg_stage;	// 1 or 2
+	tens4dmm m_dbg_cx, m_dbg_cp, m_dbg_cpAl, m_dbg_calph;	// spatial term groups of TangentMm
+	void FDCheck(FEMaterialPoint& mp, const tens4dmm& c);
+
