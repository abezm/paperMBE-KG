+
+//=============================================================================
+// TANCHECK (optional, debug only)
+// Central finite differences of the PK2 stress S(C) returned by Stress(), at fixed
+// history (Jp, Fo, svo, current time and time step). The perturbed state uses
+// F' = U' = sqrt(C'), so S is evaluated as a function of C only. The material
+// tangent 2 dS/dC is pushed forward, c = (1/J) F F F F : C, with the F of the
+// current call, and compared with the spatial tangent returned by TangentMm and
+// with its term groups (cx, cp, cpAl, calph).
+static mat3d tc_sqrt(const mat3ds& C, double& res)
+{
+	double l[3]; vec3d r[3];
+	C.eigen(l, r);
+	mat3ds U(0.0);
+	for (int a = 0; a < 3; ++a) { vec3d e = r[a]; e.unit(); U += dyad(e)*sqrt(l[a]); }
+	res = 0.0;
+	mat3d U2 = mat3d(U)*mat3d(U);
+	for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) res = std::max(res, fabs(U2(i,j) - C(i,j)));
+	return mat3d(U);
+}
+
+void FEKinematicGrowthZ::FDCheck(FEMaterialPoint& mp, const tens4dmm& c)
+{
+	FEElasticMaterialPoint& ep = *mp.ExtractData<FEElasticMaterialPoint>();
+	FEKinematicMaterialPointZ& pt = *mp.ExtractData<FEKinematicMaterialPointZ>();
+	double t  = GetFEModel()->GetTime().currentTime;
+	double dt = GetTimeInfo().timeIncrement;
+
+	// save everything Stress() writes
+	mat3d  F0 = ep.m_F; double J0 = ep.m_J;
+	double sJ = pt.m_J; mat3d sFg = pt.m_Fg; double sed = pt.m_elas_dmg, scd = pt.m_coll_dmg;
+	double ssvo = pt.m_svo; mat3d sFo = pt.m_Fo;
+	tens4dmm gcx = m_dbg_cx, gcp = m_dbg_cp, gcpAl = m_dbg_cpAl, gcal = m_dbg_calph;
+
+	m_dbg_infd = true; m_dbg_freeze = false;
+
+	// base state with the F of the call
+	mat3ds C0 = ep.RightCauchyGreen();
+	Stress(mp);
+	double alpha0 = m_dbg_alpha_cur;
+	mat3ds S0 = m_dbg_S;
+	int stage = m_dbg_stage;
+	double svx0 = m_dbg_svx, p0 = m_dbg_p, palg0 = m_dbg_palg;
+	// base state with F = sqrt(C) (checks that S depends on C only)
+	double res = 0.0, maxres = 0.0;
+	mat3d U0 = tc_sqrt(C0, res); maxres = res;
+	ep.m_F = U0; ep.m_J = U0.det();
+	Stress(mp);
+	mat3ds S0U = m_dbg_S;
+	double dSU = 0.0;
+	for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) dSU = std::max(dSU, fabs(S0U(i,j) - S0(i,j)));
+
+	double cmax = 0.0;
+	for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) cmax = std::max(cmax, fabs(C0(i,j)));
+	double h = m_fd_eps*cmax;
+
+	// material tangents: [0] S total, [1] Sx (angle free), [2] Sx (angle frozen), [3] S_alg = -J p_alg C^-1, [4] S_con = S - Sx - S_alg
+	const int NG = 5;
+	static double CM[NG][3][3][3][3];
+	for (int g = 0; g < NG; ++g) for (int a = 0; a < 81; ++a) (&CM[g][0][0][0][0])[a] = 0.0;
+	const int KL[6][2] = {{0,0},{1,1},{2,2},{0,1},{1,2},{0,2}};
+	for (int m = 0; m < 6; ++m)
+	{
+		int K = KL[m][0], L = KL[m][1];
+		mat3ds dC(0.0); dC(K,L) = h;		// symmetric: sets (K,L) and (L,K)
+		mat3ds Sv[2][NG];
+		for (int sg = 0; sg < 2; ++sg)
+		{
+			mat3ds Cq = (sg == 0 ? C0 + dC : C0 - dC);
+			mat3d Fq = tc_sqrt(Cq, res); maxres = std::max(maxres, res);
+			ep.m_F = Fq; ep.m_J = Fq.det();
+			double Jq = ep.m_J; mat3ds Ciq = Cq.inverse();
+			m_dbg_freeze = false; Stress(mp);
+			mat3ds S = m_dbg_S, Sx = m_dbg_Sx; double palg = m_dbg_palg;
+			mat3ds Salg = Ciq*(-Jq*palg);
+			m_dbg_freeze = true; m_dbg_alpha = alpha0; Stress(mp); m_dbg_freeze = false;
+			mat3ds Sxf = m_dbg_Sx;
+			Sv[sg][0] = S; Sv[sg][1] = Sx; Sv[sg][2] = Sxf; Sv[sg][3] = Salg; Sv[sg][4] = S - Sx - Salg;
+		}
+		double fac = (K == L ? 1.0/h : 0.5/h);
+		for (int g = 0; g < NG; ++g)
+			for (int I = 0; I < 3; ++I) for (int J = 0; J < 3; ++J)
+			{
+				double d = (Sv[0][g](I,J) - Sv[1][g](I,J))*fac;
+				CM[g][I][J][K][L] = d; CM[g][I][J][L][K] = d;
+			}
+	}
+
+	// restore the state of the call
+	ep.m_F = F0; ep.m_J = J0;
+	pt.m_J = sJ; pt.m_Fg = sFg; pt.m_elas_dmg = sed; pt.m_coll_dmg = scd; pt.m_svo = ssvo; pt.m_Fo = sFo;
+	m_dbg_cx = gcx; m_dbg_cp = gcp; m_dbg_cpAl = gcpAl; m_dbg_calph = gcal;
+	m_dbg_infd = false; m_dbg_freeze = false;
+
+	// push forward with the F of the call
+	static double cs[NG][3][3][3][3];
+	for (int g = 0; g < NG; ++g)
+		for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) for (int k = 0; k < 3; ++k) for (int l = 0; l < 3; ++l)
+		{
+			double sum = 0.0;
+			for (int I = 0; I < 3; ++I) for (int J = 0; J < 3; ++J) for (int K = 0; K < 3; ++K) for (int L = 0; L < 3; ++L)
+				sum += F0(i,I)*F0(j,J)*F0(k,K)*F0(l,L)*CM[g][I][J][K][L];
+			cs[g][i][j][k][l] = sum/J0;
+		}
+
+	// coded groups and FD counterparts (6x6 Voigt: 00 11 22 01 12 02)
+	const char* gname[5] = {"total", "cx", "calph", "cpAl", "cp"};
+	tens4dmm gcode[5] = {c, gcx, gcal, gcpAl, gcp};
+	double fd[5][6][6], cd[5][6][6];
+	for (int a = 0; a < 6; ++a) for (int b = 0; b < 6; ++b)
+	{
+		int i = KL[a][0], j = KL[a][1], k = KL[b][0], l = KL[b][1];
+		fd[0][a][b] = cs[0][i][j][k][l];
+		fd[1][a][b] = cs[2][i][j][k][l];
+		fd[2][a][b] = cs[1][i][j][k][l] - cs[2][i][j][k][l];
+		fd[3][a][b] = cs[3][i][j][k][l];
+		fd[4][a][b] = cs[4][i][j][k][l];
+		for (int g = 0; g < 5; ++g) cd[g][a][b] = gcode[g](i,j,k,l);
+	}
+	double ref = 0.0;
+	for (int a = 0; a < 6; ++a) for (int b = 0; b < 6; ++b) ref = std::max(ref, fabs(fd[0][a][b]));
+
+	int iel = mp.m_elem->GetID();
+	feLog("FDCHK ==== t=%.10g dt=%.6g elem=%d gp=%d stage=%d MBE=%d alp_update=%d\n", t, dt, iel, mp.m_index, stage, (int)m_MBE_opt, (int)m_alpm);
+	feLog("FDCHK J=%.15e Jp=%.15e svo=%.10e svx=%.10e p=%.10e p_alg=%.10e alpha=%.10f deg\n", J0, pt.m_Jp, pt.m_svo, svx0, p0, palg0, alpha0*180.0/M_PI);
+	feLog("FDCHK h=%.3e (fd_eps=%.1e, max|C|=%.6g) max|U^2-C|=%.3e max|S(F)-S(sqrt C)|=%.3e max|c_fd total|=%.6e\n", h, m_fd_eps, cmax, maxres, dSU, ref);
+	for (int g = 0; g < 5; ++g)
+	{
+		if (stage == 1 && g > 0) break;
+		double emax = 0.0, fmax = 0.0, cmx = 0.0; int ea = 0, eb = 0;
+		for (int a = 0; a < 6; ++a) for (int b = 0; b < 6; ++b)
+		{
+			double e = fabs(cd[g][a][b] - fd[g][a][b]);
+			if (e > emax) { emax = e; ea = a; eb = b; }
+			fmax = std::max(fmax, fabs(fd[g][a][b])); cmx = std::max(cmx, fabs(cd[g][a][b]));
+		}
+		double asym_c = 0.0, asym_f = 0.0;
+		for (int a = 0; a < 6; ++a) for (int b = 0; b < 6; ++b)
+		{
+			asym_c = std::max(asym_c, fabs(cd[g][a][b] - cd[g][b][a]));
+			asym_f = std::max(asym_f, fabs(fd[g][a][b] - fd[g][b][a]));
+		}
+		feLog("FDCHK group %-6s max|code|=%.6e max|fd|=%.6e max|code-fd|=%.6e at (%d,%d) rel_to_total=%.3e rel_to_group=%.3e asym(code)=%.3e asym(fd)=%.3e\n",
+			gname[g], cmx, fmax, emax, ea, eb, (ref > 0 ? emax/ref : 0.0), (fmax > 0 ? emax/fmax : 0.0), asym_c, asym_f);
+	}
+	for (int g = 0; g < 5; ++g)
+	{
+		if (stage == 1 && g > 0) break;
+		for (int a = 0; a < 6; ++a)
+		{
+			feLog("FDCHK %-6s code row%d:", gname[g], a); for (int b = 0; b < 6; ++b) feLog(" %+.8e", cd[g][a][b]); feLog("\n");
+			feLog("FDCHK %-6s fd   row%d:", gname[g], a); for (int b = 0; b < 6; ++b) feLog(" %+.8e", fd[g][a][b]); feLog("\n");
+		}
+	}
+}
