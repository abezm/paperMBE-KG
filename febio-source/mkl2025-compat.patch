+
+#pragma once
+#include "mkl_spblas.h"
+
+// The NIST-style sparse BLAS triangular solver mkl_dcsrtrsv was removed from
+// oneMKL (2025+). This helper provides the same one-based CSR triangular solve
+// through the inspector-executor API, which is available in all supported MKL
+// versions. Solves op(T)*x = y, where T is the triangle of A selected by uplo.
+inline bool csrtrsv(char uplo, char trans, char diag, int n, double* a, int* ia, int* ja, double* y, double* x)
+{
+	sparse_matrix_t A = nullptr;
+	if (mkl_sparse_d_create_csr(&A, SPARSE_INDEX_BASE_ONE, n, n, ia, ia + 1, ja, a) != SPARSE_STATUS_SUCCESS) return false;
+
+	matrix_descr descr;
+	descr.type = SPARSE_MATRIX_TYPE_TRIANGULAR;
+	descr.mode = ((uplo == 'L') || (uplo == 'l')) ? SPARSE_FILL_MODE_LOWER : SPARSE_FILL_MODE_UPPER;
+	descr.diag = ((diag == 'U') || (diag == 'u')) ? SPARSE_DIAG_UNIT : SPARSE_DIAG_NON_UNIT;
+
+	sparse_operation_t op = ((trans == 'T') || (trans == 't')) ? SPARSE_OPERATION_TRANSPOSE : SPARSE_OPERATION_NON_TRANSPOSE;
+
+	sparse_status_t status = mkl_sparse_d_trsv(op, 1.0, A, descr, y, x);
+	mkl_sparse_destroy(A);
+
+	return (status == SPARSE_STATUS_SUCCESS);
+}
