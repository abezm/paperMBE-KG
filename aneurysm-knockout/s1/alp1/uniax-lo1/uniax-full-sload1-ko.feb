<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>600</time_steps>
		<step_size>0.01</step_size>
		<time_stepper type="default">
			<max_retries>4</max_retries>
			<opt_iter>11</opt_iter>
			<dtmin>0.01</dtmin>
			<dtmax lc="2">0.01</dtmax>
		</time_stepper>
		<solver type="solid">
			<symmetric_stiffness>0</symmetric_stiffness>
			<lstol>0</lstol>
			<max_refs>15</max_refs>
			<reform_each_time_step>1</reform_each_time_step>
			<diverge_reform>0</diverge_reform>
			<dtol>1e-10</dtol>
			<etol>1e-10</etol>
			<rtol>1e-10</rtol>
			<min_residual>1e-15</min_residual>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>0</R>
			<Fc>0</Fc>
		</Constants>
	</Globals>
	<Material>	
		<material id="1" name="Material1" type="KinematicGrowth">
			<density>1</density>
			<elastic type="neo-Hookean">
				<E>200.0</E>
				<v>0.0</v>
			</elastic>
			<c_e>89.71</c_e>
			<c_m>261.4</c_m>
			<d_m>0.240</d_m>
			<c_c>234.9</c_c>
			<d_c>4.08</d_c>
			<alpha>29.91</alpha>
			<beta_t>0.056</beta_t>
			<beta_z>0.067</beta_z>
			<f_e>0.34</f_e>
			<f_c>0.33</f_c>
			<k_parameter>0.1</k_parameter>
			<gr_start>1.0</gr_start>
			<gr_end>11.0</gr_end>
			<MBE>0</MBE>
			<hyperels_mod>3</hyperels_mod>
			<secant_tangent>0</secant_tangent>
			<ec_degrad>1</ec_degrad>
			<mu_out>1.0</mu_out>
			<cc_out>1.0</cc_out>
			<z_center>0.0</z_center>
			<z_spread>1.0</z_spread>
			<z_nu>2</z_nu>
			<k_J>1e6</k_J>
			<mu_in>1.0</mu_in>
			<cc_in>1.0</cc_in>
			<Gm>1.0</Gm>
			<Gc>1.0</Gc>
			<Ge_t>1.0</Ge_t>
			<Ge_z>1.0</Ge_z>
			<asymm_aneurysm>0</asymm_aneurysm>
			<lo_opt>1</lo_opt>
			<alp_update>1</alp_update>
		</material>
	</Material>
	<Mesh>
				<Nodes name="box">
			<node id="1">99.5,-0.5,0</node>
			<node id="2">100.5,-0.5,0</node>
			<node id="3">100.5,0.5,0</node>
			<node id="4">99.5,0.5,0</node>
			<node id="5">99.5,-0.5,1</node>
			<node id="6">100.5,-0.5,1</node>
			<node id="7">100.5,0.5,1</node>
			<node id="8">99.5,0.5,1</node>
		</Nodes>
		<Elements type="hex8" name="Part1">
			<elem id="1">1,2,3,4,5,6,7,8</elem>
		</Elements>
				<NodeSet name="fixZ">1, 2, 3, 4</NodeSet>
		<NodeSet name="pin">1</NodeSet>
		<NodeSet name="rollY">2</NodeSet>
		<NodeSet name="rollX">4</NodeSet>
		<NodeSet name="Nodal_force1">5, 6, 7, 8</NodeSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="Material1"/>
	</MeshDomains>
	<Boundary>
		<bc name="fixZ" node_set="fixZ" type="zero displacement"><z_dof>1</z_dof></bc>
		<bc name="pin" node_set="pin" type="zero displacement"><x_dof>1</x_dof><y_dof>1</y_dof></bc>
		<bc name="rollY" node_set="rollY" type="zero displacement"><y_dof>1</y_dof></bc>
		<bc name="rollX" node_set="rollX" type="zero displacement"><x_dof>1</x_dof></bc>
	</Boundary>
	<Loads>
		<nodal_load name="Nodal_force1" node_set="Nodal_force1" type="nodal_force">
			<relative>0</relative>
			<value lc="1">0,0,48.82</value>
			<shell_bottom>0</shell_bottom>
		</nodal_load>
	</Loads>
	<LoadData>
		<load_controller id="1" name="LC1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
				<pt>2,3</pt>
				<pt>50,3</pt>
			</points>
		</load_controller>
		<load_controller id="2" name="MustPoints" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0.01</pt>
				<pt>1.0,0.01</pt>
				<pt>10000,0.01</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="relative volume"/>
			<var type="nodal stress"/>
			<var type="strain energy density"/>
		</plotfile>
		<logfile>
	<node_data file="node7_sp1ko.txt" data="ux;uy;uz" name="node7_dat" delim="," >7 </node_data>
	<element_data file="elem1_sp1ko.txt" data="sx;sy;sz;J;Fgxx" name="elem1_dat"  delim="," >1 </element_data>
		</logfile>
	</Output>
</febio_spec>
